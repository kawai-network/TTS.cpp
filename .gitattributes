# Enforce LF line endings for Go source files
*.go text eol=lf

# Enforce LF line endings for common source files
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf

# Shell scripts should use LF
*.sh text eol=lf

# CMake files should use LF
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# YAML files should use LF
*.yml text eol=lf
*.yaml text eol=lf

# Keep native line endings for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.obj binary
*.o binary
*.gguf binary
*.bin binary
